; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Gemcore"
config/description="Match-three with mineral finds"
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

Data="*res://scripts/autoload/data.gd"
Save="*res://scripts/autoload/save_game.gd"
Sfx="*res://scripts/autoload/sfx.gd"
UI="*res://scripts/autoload/ui.gd"
Spec="*res://scripts/autoload/spec.gd"
Ov="*res://scripts/autoload/overlay.gd"

[display]

window/size/viewport_width=390
window/size/viewport_height=844
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

anti_aliasing/quality/msaa_2d=2

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[shader_globals]

fluor_uv={
"type": "float",
"value": 0.0
}
heart_beat={
"type": "float",
"value": 0.0
}
